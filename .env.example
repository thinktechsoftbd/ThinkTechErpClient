# Copy to .env.local and fill in. All values are server-side only (never sent to the browser).

# API base URL. Locally use the API's plain-HTTP port: calls are server-to-server, and Node does not
# trust the ASP.NET dev certificate. In production use the API's public HTTPS address.
API_BASE_URL=http://localhost:5291

# "api" (default): POST credentials to the API's login endpoint; the API's refresh token keeps
# the session alive. "dev": local sign-in that mints an API-compatible JWT (ignored in production builds).
AUTH_MODE=api
AUTH_LOGIN_PATH=/api/security/auth/login
AUTH_REFRESH_PATH=/api/security/auth/refresh
AUTH_LOGOUT_PATH=/api/security/auth/logout

# AUTH_MODE=dev only; must match the API's Authentication:Jwt:* settings. Leave empty for "api"
# mode: the client trusts the token the API returns and never needs the API's signing key.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_SIGNING_KEY=

# AUTH_MODE=dev only: the single local account and the roles placed in its token.
DEV_AUTH_USERNAME=admin
DEV_AUTH_PASSWORD=
DEV_AUTH_ROLES=admin,sms_admin

# Local development only: pre-filled on the sign-in form (ignored in production builds).
# Keep real credentials in .env.local only, and quote values containing # or $, e.g. '...'.
LOGIN_DEFAULT_EMAIL=
LOGIN_DEFAULT_PASSWORD=

# IANA time zone for dates rendered on the server (defaults to the server's zone), e.g. Asia/Dhaka.
APP_TIME_ZONE=
