# Copy to .env.local and fill in. All values are server-side only (never sent to the browser).

# Base URL of ThinkTechErpAPI. Use the API's "http" launch profile, or an https URL
# with NODE_USE_SYSTEM_CA=1 so Node trusts the ASP.NET dev certificate.
API_BASE_URL=http://localhost:5291

# "api" (default): POST credentials to the API's login endpoint.
# "dev": local development sign-in that mints an API-compatible JWT (ignored in production builds).
AUTH_MODE=api
AUTH_LOGIN_PATH=/api/security/auth/login
AUTH_LOGOUT_PATH=/api/security/auth/logout

# Must match the API's Authentication:Jwt:* settings.
# Required for AUTH_MODE=dev. Optional for "api" mode: when set, the session token's signature is verified here too.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_SIGNING_KEY=

# AUTH_MODE=dev only: the single local account and the roles placed in its token.
DEV_AUTH_USERNAME=admin
DEV_AUTH_PASSWORD=
DEV_AUTH_ROLES=admin,sms_admin

# IANA time zone for dates rendered on the server (defaults to the server's zone), e.g. Asia/Dhaka.
APP_TIME_ZONE=
